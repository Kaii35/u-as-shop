{
  "name": "aurelle-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:studio": "npm --prefix server run prisma:studio",
    "api": "npm --prefix server run dev",
    "api:install": "npm --prefix server install",
    "api:migrate": "npm --prefix server run prisma:migrate",
    "api:seed": "npm --prefix server run seed",
    "api:typecheck": "npm --prefix server run typecheck",
    "setup": "npm run db:up && npm run api:install && npm --prefix server run prisma:generate && npm --prefix server run prisma:deploy && npm run api:seed"
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
