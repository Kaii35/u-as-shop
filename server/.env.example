# Copia este archivo a server/.env y ajusta lo que necesites.
# server/.env NO se versiona: lleva secretos.

# Apunta al Postgres del docker-compose de la raíz (puerto 5436).
DATABASE_URL="postgresql://aurelle:aurelle_dev@localhost:5436/aurelle?schema=public"

PORT=4100
HOST=0.0.0.0

# Firma los tokens del panel. En produccion tiene que ser un secreto propio
# de 32+ caracteres o el servidor se niega a arrancar.
JWT_SECRET=cambiar-en-produccion

# Origenes del navegador autorizados, separados por coma.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Primer usuario del panel. Solo se usa al sembrar: si ya existe, el seed
# no le toca la contrasena.
ADMIN_EMAIL=admin@aurelle.co
ADMIN_PASSWORD=aurelle-admin

# Meses de historia de ventas que inventa el seed, y la semilla del
# generador. Fija a proposito: dos siembras dan exactamente lo mismo.
SEED_MONTHS=14
SEED_RANDOM=20260924

# ---------------------------------------------------------------------------
# Pagos
# ---------------------------------------------------------------------------

# `mock` permite probar el flujo completo sin credenciales: la pasarela se
# simula y se puede aprobar o rechazar a mano. `wompi` cobra de verdad.
PAYMENT_PROVIDER=mock

# Credenciales de Wompi. Sandbox lleva prefijos _test_, produccion _prod_.
# Las tres ultimas NO pueden salir de este archivo ni acabar en una variable
# VITE_: quedarian publicadas en el bundle del navegador.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Solo para forzarla; por defecto se deduce del prefijo de la llave publica.
# WOMPI_API_URL=https://sandbox.wompi.co/v1

# Registra la cadena firmada al verificar un webhook, para depurar el primero.
# Se ignora en produccion: esa cadena lleva el secreto de eventos dentro.
WOMPI_DEBUG_EVENTS=false

# Base publica del sitio. De aqui sale la URL a la que vuelve la clienta.
APP_URL=http://localhost:5173

# Minutos que se apartan las unidades mientras se paga.
RESERVATION_MINUTES=15
