# Copia este archivo a server/.env y ajusta lo que necesites.
# server/.env NO se versiona: lleva secretos.

# Apunta al Postgres del docker-compose de la raíz (puerto 5436).
DATABASE_URL="postgresql://aurelle:aurelle_dev@localhost:5436/aurelle?schema=public"

PORT=4100
HOST=0.0.0.0

# Firma los tokens del panel. En produccion tiene que ser un secreto propio
# de 32+ caracteres o el servidor se niega a arrancar.
JWT_SECRET=cambiar-en-produccion

# Origenes del navegador autorizados, separados por coma.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Primer usuario del panel. Solo se usa al sembrar: si ya existe, el seed
# no le toca la contrasena.
ADMIN_EMAIL=admin@aurelle.co
ADMIN_PASSWORD=aurelle-admin

# Meses de historia de ventas que inventa el seed, y la semilla del
# generador. Fija a proposito: dos siembras dan exactamente lo mismo.
SEED_MONTHS=14
SEED_RANDOM=20260924
